# Uncompressed flow outputs are not committed — the COMPRESSED signoff collateral under
# collateral/ is (gds/spef/def gzipped, plus abstract LEF/Liberty views).
*.gds
*.spef
*.def
*.odb
*.lyrdb
!collateral/**/*.gz
!collateral/views/*

# Flow working directories
results/
objects/
logs/
reports/pv/*/

# Local staging for GitHub Release assets (superseded by collateral/, kept out of git)
release_assets/

# Local noise
.DS_Store
__pycache__/
*.pyc
*.bak
obj_*/
